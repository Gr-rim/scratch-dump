{
  "manifest_version": 3,
  "name": "ScratchDump",
  "version": "1.2.0",
  "description": "A per-site scratchpad that organises your notes by website, stored locally.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "https://cdn.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "backend/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["frontend/panel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
