{
  "manifest_version": 3,
  "name": "ScratchDump",
  "version": "1.1.8",
  "description": "A per-site scratchpad that organises your notes by website, stored locally.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://cdn.jsdelivr.net/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "backend/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["backend/content.js"],
      "css": ["backend/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["frontend/panel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
